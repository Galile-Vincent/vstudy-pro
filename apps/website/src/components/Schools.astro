---
/** A local fictional school walkthrough. Reduced motion and no JavaScript show the complete static list. */
import { exampleSchools, trustCopy } from '../data/trust';
import type { Language } from '../data/ui';
import { path } from '../config';
import '../styles/schools.css';
interface Props { language: Language; }
const { language } = Astro.props;
const t = trustCopy[language];
---
<section class="schools-section container" aria-labelledby="schools-title">
  <div class="school-intro">
    <h2 id="schools-title">{t.schoolTitle}</h2>
    <p class="school-promise">{t.schoolBody}</p>
    <p>{t.availability}</p>
    <a class="text-link" href={path(`${language}/docs/connect-your-school/#availability`)}>{t.schoolDocs}<span aria-hidden="true">↗</span></a>
    <p class="school-origin">{t.cycu}</p>
  </div>
  <div class="school-demo" data-school-demo data-enhanced role="region" aria-roledescription={t.carousel} aria-label={t.schoolTitle} aria-describedby="school-demo-note">
    <p id="school-demo-note" class="school-demo-note">{t.demo}</p>
    <div class="school-stage" data-school-stage aria-live="off" aria-atomic="true">
      {exampleSchools.map((school, index) => <div class="school-slide" data-school-slide data-query={school.name} data-active={index === 0 ? '' : undefined}>
        <div class="school-search"><span aria-hidden="true">⌕</span><span class="sr-only">{t.search}: {school.name}</span><span data-school-query aria-hidden="true">{school.name}</span></div>
        <div class="school-result">
          <span class="school-monogram" aria-hidden="true" style={`--tile-angle:${120 + index * 24}deg`}>{school.monogram}</span>
          <div class="school-identity"><h3>{school.name}</h3><p>{t.countries[school.country]}</p></div>
          <p class="school-detected"><span aria-hidden="true">✓</span>{t.detected}</p>
          <button type="button" class="school-connect" data-school-connect aria-label={`${t.connect} · ${school.name} · ${t.demo}`}>{t.connect}<span aria-hidden="true">↗</span></button>
        </div>
        <p class="school-signin"><span aria-hidden="true">02</span>{t.signIn}</p>
      </div>)}
    </div>
    <div class="school-controls" data-school-controls>
      <button type="button" data-school-play data-pause={t.pause} data-play={t.play}>{t.pause}</button>
      <div class="school-paging">
        <button type="button" data-school-prev aria-label={t.previous}>←</button>
        {exampleSchools.map((school, index) => <button type="button" class="school-dot" data-school-dot={index} aria-label={`${t.show} ${school.name}`} aria-current={index === 0 ? 'true' : 'false'}><span></span></button>)}
        <button type="button" data-school-next aria-label={t.next}>→</button>
      </div>
    </div>
  </div>
</section>
<noscript><style>.school-controls { display:none; }.school-demo[data-enhanced] .school-stage { display:block; min-height:0; }.school-demo[data-enhanced] .school-slide { opacity:1; transform:none; visibility:visible; pointer-events:auto; margin-top:24px; }</style></noscript>
<script>
  import '../scripts/schools';
</script>
