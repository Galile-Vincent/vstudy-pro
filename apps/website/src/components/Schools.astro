---
/** A static connection guide. First-view motion never changes content, focus, or layout. */
import { trustCopy } from '../data/trust';
import type { Language } from '../data/ui';
import { path } from '../config';
import '../styles/schools.css';
interface Props { language: Language; }
const { language } = Astro.props;
const t = trustCopy[language];
const icons = [
  'M3 10 12 4l9 6M5 10v10h14V10M9 20v-6h6v6M9 10h.01M15 10h.01',
  'M13 5H5v14h14v-8M10 14 21 3M14 3h7v7',
  'M3 5h6c2 0 3 1 3 2 0-1 1-2 3-2h6v14h-6c-2 0-3 1-3 2 0-1-1-2-3-2H3ZM12 7v14',
];
---
<section class="schools-section container" aria-labelledby="schools-title">
  <div class="school-band" data-school-band>
    <div class="school-intro">
      <p class="school-eyebrow">{t.schoolEyebrow}</p>
      <h2 id="schools-title">{t.schoolTitle}</h2>
      <p class="school-promise">{t.schoolBody}</p>
    </div>
    <div class="school-connection">
      <ol class="school-flow">
        {t.schoolSteps.map((step, index) => <li class="school-step" style={`--step:${index}`}>
          <span class="school-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={icons[index]} /></svg></span>
          <p><span class="school-number" aria-hidden="true">0{index + 1}</span>{step}</p>
        </li>)}
      </ol>
      <div class="school-links">
        <a href="https://stats.moodle.org/sites/" target="_blank" rel="noopener noreferrer">{t.schoolLookup}<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10" /></svg><span class="sr-only"> ({t.newTab})</span></a>
        <a href={path(`${language}/docs/connect-your-school/#availability`)}>{t.schoolDocs}<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16m-6-6 6 6-6 6" /></svg></a>
      </div>
    </div>
    <p class="school-note">{t.schoolNote}</p>
  </div>
</section>
<script>
  const band = document.querySelector('[data-school-band]');
  if (band) {
    const observer = new IntersectionObserver(entries => {
      if (entries.some(entry => entry.isIntersecting)) {
        band.setAttribute('data-seen', '');
        observer.disconnect();
      }
    }, { threshold: 0.2 });
    observer.observe(band);
  }
</script>
