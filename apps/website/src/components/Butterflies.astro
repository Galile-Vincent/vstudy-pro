---
import { path } from '../config';
---
<div class="butterfly-flight" aria-hidden="true" hidden>
  {Array.from({length:4}, () => <span class="butterfly"><span class="wing wing-left"><img src={path('brand/symbol.svg')} width="226" height="178" alt="VStudy Pro" /></span><span class="wing wing-right"><img src={path('brand/symbol.svg')} width="226" height="178" alt="VStudy Pro" /></span></span>)}
</div>
<style>
  .butterfly-flight { position:fixed; inset:0; pointer-events:none; z-index:1; overflow:hidden; contain:strict; }
  .butterfly { position:absolute; left:0; top:0; width:26px; height:22px; opacity:0; }
  .wing { position:absolute; inset:0; transform-origin:center; }
  .wing img { width:100%; height:100%; }
  .wing-left { clip-path:inset(0 50% 0 0); }
  .wing-right { clip-path:inset(0 0 0 50%); }
  @media(prefers-reduced-motion:reduce) { .butterfly-flight { display:none; } }
</style>
<script>
  import '../scripts/butterflies';
</script>
