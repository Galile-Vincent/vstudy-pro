---
import { getImage } from 'astro:assets';
import Window from './Window.astro';
import { shot } from '../data/shots';
import { ui, type Language } from '../data/ui';
import { redesign } from '../data/v2';
import { path } from '../config';
import palettes from '../../../desktop/src/shared/themes/palettes.json';
interface Props { language: Language; }
const { language } = Astro.props;
const t = ui[language];
const v = redesign[language];
const doc = (slug: string) => path(`${language}/docs/${slug}/`);
const previews = await Promise.all(palettes.slice(0,6).map(async pack => ({...pack,
  lightShot:(await getImage({src:shot(`themes-settings-${pack.id}-light`),width:600,format:'webp',quality:80})).src,
  darkShot:(await getImage({src:shot(`themes-settings-${pack.id}-dark`),width:600,format:'webp',quality:80})).src,
})));
---
<section class="features-section container" id="features" aria-labelledby="features-title">
  <h2 id="features-title" class="section-intro" data-reveal>{t.featureTitle}</h2>
  <div class="bento-grid">
    <article class="bento bento-course bento-wide" data-reveal>
      <div class="bento-copy"><h3>{t.courseTitle}</h3><p>{t.courseBody}</p><a class="text-link" href={doc('courses-and-deadlines')}>{t.courseLink}<span aria-hidden="true">↗</span></a></div>
      <div class="deadline-demo"><span>{v.demo} · {v.course}</span><span class="deadline-chip"><span class="pulse-dot" aria-hidden="true"></span>{v.deadline} <b data-deadline aria-hidden="true">16:59:59</b><span class="sr-only">17 h</span></span></div>
      <div class="bento-shot course-crop"><Window name="course" alt={t.coursePageAlt} size={960} /></div>
    </article>
    <article class="bento bento-agent" data-reveal style="--reveal-delay:60ms">
      <div class="bento-copy"><h3>{t.agentTitle}</h3><p>{t.agentBody}</p><a class="text-link" href={doc('study-planner')}>{t.agentLink}<span aria-hidden="true">↗</span></a></div>
      <div class="approval-demo"><span class="demo-label">{v.demo}</span><p>{v.review}</p><ul>{v.tasks.map(task => <li><span aria-hidden="true"></span>{task}</li>)}</ul><button class="button" data-approve data-label={v.approve} data-approved={v.approved}>{v.approve}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></button><button class="reset-demo" data-reset hidden>{v.reset}</button><span class="sr-only" data-approval-status role="status"></span></div>
    </article>
    <article class="bento bento-history" data-reveal>
      <div class="bento-copy"><h3>{t.extras[0]![0]}</h3><p>{t.extras[0]![1]}</p><a class="text-link" href={doc('chat-history')}>{t.docs}<span aria-hidden="true">↗</span><span class="sr-only">{t.extras[0]![0]}</span></a></div>
      <div class="history-demo"><label for="history-demo">{v.search}<kbd>⌘ K</kbd></label><input id="history-demo" type="search" value={v.query} data-match={v.query} autocomplete="off" spellcheck="false" /><div class="history-result" data-history-result><span class="demo-label">{v.demo}</span><p>{v.result}</p><span>{v.query} · Moodle</span></div><p data-history-empty hidden>{v.noResults}</p></div>
    </article>
    <article class="bento bento-reader bento-wide" data-reveal style="--reveal-delay:60ms">
      <div class="bento-copy"><h3>{t.readerTitle}</h3><p>{t.readerBody}</p><a class="text-link" href={doc('reading-documents')}>{t.readerLink}<span aria-hidden="true">↗</span></a></div>
      <div class="bento-shot reader-crop"><Window name="reader" alt={t.readerAlt} size={960} /></div><p class="feature-note">{t.readerNote}</p>
    </article>
    <article class="bento bento-themes" data-reveal>
      <div class="bento-copy"><h3>{t.themesTitle}</h3><p>{t.themesBody}</p></div>
      <div class="theme-picker" role="group" aria-label={t.themesTitle}>
        {previews.map((pack,index) => <button class="theme-choice" data-theme-id={pack.id} data-light-shot={pack.lightShot} data-dark-shot={pack.darkShot} data-light-label={t.lightPreview} data-dark-label={t.darkPreview} aria-label={t.themeNames[index]} aria-pressed={index===0} title={t.themeNames[index]}><span class="orbs" aria-hidden="true"><span style={`--orb-bg:${pack.light[0]};--orb-accent:${pack.light[7]}`}></span><span style={`--orb-bg:${pack.dark[0]};--orb-accent:${pack.dark[7]}`}></span></span></button>)}
      </div>
      <p class="theme-hint">{t.themeHint}</p><div class="theme-preview"><Window name="themes-settings-vstudy-light" alt={`${t.themeNames[0]} · ${t.lightPreview}`} size={600} /></div>
    </article>
    <article class="bento bento-moodle" data-reveal style="--reveal-delay:60ms"><div class="bento-copy"><h3>{t.extras[1]![0]}</h3><p>{t.extras[1]![1]}</p><a class="text-link" href={doc('moodle-pages')}>{t.docs}<span aria-hidden="true">↗</span><span class="sr-only">{t.extras[1]![0]}</span></a></div><div class="bento-shot moodle-crop"><Window name="moodle" alt={t.extras[1]![0]} size={600} /></div></article>
    <article class="bento bento-reader bento-wide" data-reveal><div class="bento-copy"><h3>{t.captureTitle}</h3><p>{t.captureBody}</p><a class="text-link" href={doc('reading-documents')}>{t.readerLink}<span aria-hidden="true">↗</span></a></div><div class="bento-shot"><Window name="capture-to-chat" alt={t.captureTitle} size={960}/></div></article>
    <article class="bento" data-reveal><div class="bento-copy"><h3>{t.usageTitle}</h3><p>{t.usageBody}</p><a class="text-link" href={doc('usage')}>{t.docs}<span class="sr-only"> · {t.usageTitle}</span></a></div><div class="bento-shot"><Window name="usage-settings" alt={t.usageTitle} size={600}/></div></article>
    <article class="bento" data-reveal><div class="bento-copy"><h3>{t.connectTitle}</h3><p>{t.connectBody}</p><a class="text-link" href={doc('ai-providers')}>{t.docs}<span class="sr-only"> · {t.connectTitle}</span></a></div><div class="bento-shot"><Window name="connect-ai" alt={t.connectTitle} size={600}/></div></article>
    <article class="bento bento-mcp" data-reveal style="--reveal-delay:120ms"><div class="bento-copy"><h3>{v.mcpTitle}</h3><p>{v.mcpBody}</p><a class="text-link" href={doc('agents-mcp')}>{v.mcpLink}<span aria-hidden="true">↗</span></a></div><div class="mcp-diagram" aria-hidden="true"><span>V</span><svg width="96" height="40" viewBox="0 0 96 40" fill="none" stroke="currentColor"><path d="M0 20h96" stroke-dasharray="4 5"/><circle cx="48" cy="20" r="5" fill="currentColor"/></svg><span><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m8 3 13 13-5 5L3 8zM6 11l5-5m0 10 5-5M4 20l4-4"/></svg></span></div></article>
  </div>
</section>
