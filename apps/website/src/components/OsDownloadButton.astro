---
import PlatformLogo from './PlatformLogo.astro';
import { path } from '../config';
import { ui, type Language } from '../data/ui';
interface Props { language: Language; compact?: boolean; current?: boolean; }
const { language, compact = false, current = false } = Astro.props;
const t = ui[language];
---
<a class:list={["button", "os-download", { compact, "nav-download": compact }]} aria-current={current ? "page" : undefined} href={path(`${language}/download/`)} data-os-download data-label-default={t.download} data-label-mac={t.downloadMac} data-label-win={t.downloadWin}>
  <span data-os-logo="mac" hidden><PlatformLogo platform="mac" /></span>
  <span data-os-logo="win" hidden><PlatformLogo platform="win" /></span>
  <span data-os-download-text>{t.download}</span>
  <span data-os-download-short>{t.download}</span>
</a>
<script>
  import { detectInstaller } from '../scripts/platform';
  import { installers } from '../data/downloads';
  detectInstaller(id => {
    const platform = installers.find(installer => installer.id === id)?.platform;
    document.querySelectorAll<HTMLElement>('[data-os-download]').forEach(link => {
      const label = platform && link.dataset[platform === 'mac' ? 'labelMac' : 'labelWin'];
      const text = link.querySelector('[data-os-download-text]');
      if (text) text.textContent = label || link.dataset.labelDefault || '';
      link.querySelectorAll<HTMLElement>('[data-os-logo]').forEach(logo => {
        logo.hidden = logo.dataset.osLogo !== platform;
      });
    });
  });
</script>
<style>
  [data-os-logo] { display:inline-flex; flex-shrink:0; }
  [data-os-logo][hidden] { display:none; }
  [data-os-download-short] { display:none; }
  @media(max-width:767px) {
    .nav-download { padding-inline:var(--space-3); font-size:var(--text-xs); white-space:nowrap; }
    .nav-download [data-os-download-text] { display:none; }
    .nav-download [data-os-download-short] { display:inline; }
  }
</style>
