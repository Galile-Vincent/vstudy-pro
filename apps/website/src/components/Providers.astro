---
/** Supported connection methods mirror the desktop provider IDs. Brand names use the site's own typography. */
import { providerConnections, trustCopy } from '../data/trust';
import type { Language } from '../data/ui';
import { path } from '../config';
interface Props { language: Language; }
const { language } = Astro.props;
const t = trustCopy[language];
---
<section class="providers-section container" aria-labelledby="providers-title">
  <div class="providers-intro"><h2 id="providers-title">{t.providerTitle}</h2><p>{t.providerBody}</p><a class="text-link" href={path(`${language}/docs/ai-providers/`)}>{t.providerDocs}<span aria-hidden="true">↗</span></a></div>
  <ul class="provider-grid">
    {Object.entries(providerConnections).map(([id, provider]) => <li class="provider-card" data-provider-id={id}>
      <span class="provider-brand">{provider.brand}</span>
      <h3>{provider.name}</h3>
      <p class="provider-connection">{t[provider.connection]}</p>
      {id === 'codex-cli' && <p class="provider-limit">{t.macOnly}</p>}
      <p class="provider-privacy">{t.privacy[provider.privacy]}</p>
    </li>)}
  </ul>
  <p class="provider-disclaimer">{t.disclaimer}</p>
</section>
<style>
  .providers-section { padding-block:var(--space-24); }
  .providers-intro { max-width:720px; }
  .providers-intro p { margin-block:var(--space-5); }
  .provider-grid { list-style:none; padding:0; margin:var(--space-10) 0 var(--space-6); display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:var(--space-4); }
  .provider-card { padding:var(--space-6); border-radius:var(--r-lg); background:var(--subtle); min-width:0; }
  .provider-brand { display:inline-block; padding:var(--space-2) var(--space-3); background:var(--surface); border-radius:var(--r-sm); font-size:var(--text-xs); font-weight:500; }
  .provider-card h3 { margin-top:var(--space-6); font-size:var(--text-lg); }
  .provider-connection { color:var(--ink); font-size:var(--text-sm); margin-top:var(--space-3); }
  .provider-limit { font-size:var(--text-xs); margin-top:var(--space-2); }
  .provider-privacy { font-size:var(--text-sm); margin-top:var(--space-5); }
  .provider-disclaimer { font-size:var(--text-xs); max-width:800px; }
  @media(max-width:1023px) { .provider-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media(max-width:600px) { .provider-grid { grid-template-columns:1fr; } .providers-section { padding-block:var(--space-16); } }
</style>
