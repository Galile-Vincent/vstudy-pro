---
import { getImage } from 'astro:assets';
import { shot } from '../data/shots';
import Base from '../layouts/Base.astro';
import Architecture from './Architecture.astro';
import Search from './Search.astro';
import DocsNav from './DocsNav.astro';

import { path, REPO_URL } from '../config';
import { guides, getGuide } from '../data/docs';
import { translations } from '../data/translations';
import { ui, type Language } from '../data/ui';
import '../styles/docs.css';
interface Props { language: Language; slug: string; }
const { language, slug } = Astro.props;
const t = ui[language];
const guide = getGuide(slug,language);
const media = new Map(await Promise.all(guide.sections.filter(section => section.image).map(async section => [section.image!.name, await getImage({src:shot(section.image!.name),width:1440,format:'webp',quality:82})] as const)));
const fallback = language !== 'en' && !translations[language]?.[slug];
const index = guides.findIndex(item => item.slug === slug);
const prev = guides[index-1];
const next = guides[index+1];
const url = (item: string) => path(`${language}/docs/${item}/`);
---
<Base {language} title={guide.title} description={guide.description} {slug} docs>
  <div class="docs-shell">
    <aside class="docs-sidebar" aria-label={t.contents}>
      <Search {language} />
      <div class="desktop-doc-nav"><DocsNav {language} {slug} /></div>
      <details class="sidebar-menu">
        <summary>{t.contents}<span aria-hidden="true">+</span></summary>
        <DocsNav {language} {slug} />
      </details>
    </aside>
    <main class="docs-main" id="main" tabindex="-1">
      {fallback && <p class="fallback-notice">{t.fallback}</p>}
      <article class="prose" lang={fallback ? 'en' : language}>
        <h1>{guide.title}</h1><p class="doc-description">{guide.description}</p>
        {guide.sections.map(section => <section aria-labelledby={section.id}>
          <h2 id={section.id}><a href={`#${section.id}`}>{section.title}<span class="heading-hash" aria-hidden="true">#</span></a></h2>
          {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
          {slug === 'getting-started' && section.id === 'install' && <p><a class="button" href={path(`${language}/download/`)}>{t.download}<span aria-hidden="true">↓</span></a></p>}
          {section.links?.map(link => link.url.startsWith('@') ? <p><a href={path(`${language}/${link.url.slice(1)}/`)}>{link.label}</a></p> : <p><a href={link.url} rel="noopener">{link.label}<span aria-hidden="true"> ↗</span></a></p>)}
          {section.steps && <ol>{section.steps.map(step => <li>{step}</li>)}</ol>}
          {section.code && <div class="code-block" data-label={language === 'zh-Hant' ? '終端機' : language === 'ja' ? 'ターミナル' : 'Terminal'}><button class="copy-code" data-copy data-label={t.copy} data-copied={t.copied} data-failed={t.copyFailed}>{t.copy}</button><pre tabindex="0" aria-label={section.title}><code>{section.code}</code></pre></div>}
          {section.image && <figure><img src={media.get(section.image.name)?.src ?? path(`assets/${section.image.name}.webp`)} width={section.image.width} height={section.image.height} alt={section.image.alt} loading="lazy" decoding="async" /></figure>}
          {section.diagram && <Architecture />}
        </section>)}
      </article>
      <p class="doc-source"><a href={`${REPO_URL}/blob/main/${guide.source}`}>{language === 'en' ? 'Source reference' : language === 'ja' ? '参照ソース' : '參考原始碼'}<span aria-hidden="true"> ↗</span></a></p>
      <nav class="page-turner" aria-label={t.docs}>
        {prev ? <a href={url(prev.slug)}><small>← {t.previous}</small><span>{getGuide(prev.slug,language).title}</span></a> : <span />}
        {next && <a href={url(next.slug)}><small>{t.next} →</small><span>{getGuide(next.slug,language).title}</span></a>}
      </nav>
      <p class="copy-status sr-only" role="status"></p>
    </main>
    <aside class="docs-toc" aria-label={t.onPage}><p>{t.onPage}</p><nav>{guide.sections.map(section => <a href={`#${section.id}`}>{section.title}</a>)}</nav></aside>
  </div>
</Base>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button => button.addEventListener('click', async () => {
    const code = button.parentElement?.querySelector('code')?.textContent;
    if (!code) return;
    const status = document.querySelector('.copy-status');
    try {
      await navigator.clipboard.writeText(code);
      button.textContent = button.dataset.copied ?? '';
      if (status) status.textContent = button.dataset.copied ?? '';
      window.setTimeout(() => { button.textContent = button.dataset.label ?? ''; },1800);
    } catch {
      if (status) status.textContent = button.dataset.failed ?? '';
    }
  }));
</script>
