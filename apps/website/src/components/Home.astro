---
import Logo from './Logo.astro';
import Butterflies from './Butterflies.astro';
import Base from '../layouts/Base.astro';
import Window from './Window.astro';
import Bento from './Bento.astro';
import OsDownloadButton from './OsDownloadButton.astro';
import Schools from './Schools.astro';
import Providers from './Providers.astro';
import { path } from '../config';
import { ui, type Language } from '../data/ui';
import { redesign } from '../data/v2';
import '../styles/home.css';
interface Props { language: Language; }
const { language } = Astro.props;
const t = ui[language];
const v = redesign[language];
const doc = (slug: string) => path(`${language}/docs/${slug}/`);
---
<Base {language} title={t.hero} description={t.sub}>
  <main id="main" tabindex="-1">
    <Butterflies />
    <section class="hero container">
      <button class="hero-brand" aria-label={{en:"Replay butterfly flight", "zh-Hant":"重播蝴蝶飛舞", ja:"蝶の飛翔をもう一度"}[language]}><Logo /></button>
      <h1><span>{v.hero[0]}</span><span>{v.hero[1]}</span></h1>
      <p class="hero-sub">{t.sub}</p>
      <div class="hero-actions"><OsDownloadButton {language} /><a class="text-link" href="#how-it-works">{t.howItWorks}<span aria-hidden="true">↓</span></a></div>
      <figure class="hero-screen">
        <div class="aurora" aria-hidden="true"></div>
        <div class="product-depth"><Window name="courses" alt={t.coursesAlt} eager /></div>
        <figcaption>{t.screenshot}<button id="motion-toggle" data-pause={v.pause} data-resume={v.resume} aria-pressed="false">{v.pause}</button></figcaption>
      </figure>
    </section>

    <Schools {language} />

    <Bento {language} />

    <Providers {language} />

    <section class="steps-section container" id="how-it-works" aria-labelledby="steps-title">
      <h2 id="steps-title" data-reveal>{t.stepsTitle}</h2>
      <ol class="steps">{t.steps.map(([title,body],index) => <li data-reveal style={`--reveal-delay:${index*60}ms`}><span class="step-number">0{index+1}</span><h3>{title}</h3><p>{body}</p></li>)}</ol>
    </section>

    <section class="privacy-section container" data-reveal>
      <div class="privacy-copy"><h2>{t.privacyTitle}</h2><p>{t.privacyBody}</p><a class="text-link" href={doc('privacy-and-network')}>{t.privacyLink}<span aria-hidden="true">↗</span></a></div>
      <div class="privacy-detail"><svg width="72" height="64" viewBox="0 0 100 84" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="15" y="6" width="70" height="49" rx="6"/><path d="M5 63h90l-6 9H11zM43 26l6 6 11-12"/></svg><p>{t.privacyDetail}</p></div>
    </section>

    <section class="faq-section container" aria-labelledby="faq-title">
      <h2 id="faq-title" data-reveal>{t.faqTitle}</h2>
      <div class="faqs">{[...t.faqs,[v.mcpQuestion,v.mcpAnswer]].map(([question,answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div>
    </section>
    <section class="final-section container" data-reveal>
      <h2>{t.finalTitle}</h2><p>{t.finalBody}</p>
      <OsDownloadButton {language} />
    </section>
  </main>
</Base>
<script>
  import '../scripts/home';
</script>
