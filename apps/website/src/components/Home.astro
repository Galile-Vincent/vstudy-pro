---
import Base from '../layouts/Base.astro';
import Window from './Window.astro';
import Download from './Download.astro';
import { path } from '../config';
import { ui, type Language } from '../data/ui';
import { getImage } from 'astro:assets';
import { shot } from '../data/shots';
import palettes from '../../../desktop/src/shared/themes/palettes.json';
import '../styles/home.css';
interface Props { language: Language; }
const { language } = Astro.props;
const t = ui[language];
const previews = await Promise.all(palettes.slice(0,6).map(async pack => ({...pack,lightShot:(await getImage({src:shot(`courses-home-${pack.id}-light`),width:720,format:'webp',quality:82})).src,darkShot:(await getImage({src:shot(`courses-home-${pack.id}-dark`),width:720,format:'webp',quality:82})).src})));
const doc = (slug: string) => path(`${language}/docs/${slug}/`);
---
<Base {language} title={t.hero} description={t.sub}>
  <main id="main" tabindex="-1">
    <section class="hero container">
      <h1>{t.hero}</h1>
      <p class="hero-sub">{t.sub}</p>
      <div class="hero-actions"><Download {language} /><a class="button secondary" href={doc('getting-started')}>{t.readDocs}<span aria-hidden="true">↗</span></a></div>
      <figure class="hero-screen"><Window name="courses" alt={t.coursesAlt} eager /><figcaption>{t.screenshot}</figcaption></figure>
    </section>

    <section class="steps-section container" aria-labelledby="steps-title">
      <h2 id="steps-title">{t.stepsTitle}</h2>
      <ol class="steps">{t.steps.map(([title,body],index) => <li><span class="step-number">{index+1}</span><h3>{title}</h3><p>{body}</p></li>)}</ol>
    </section>

    <section class="features-section container" id="features" aria-labelledby="features-title">
      <h2 id="features-title" class="section-intro">{t.featureTitle}</h2>
      <div class="feature-row">
        <div class="feature-copy"><h3>{t.courseTitle}</h3><p>{t.courseBody}</p><a class="text-link" href={doc('courses-and-deadlines')}>{t.courseLink}<span aria-hidden="true">↗</span></a></div>
        <div class="feature-image course-image"><Window name="course" alt={t.coursePageAlt} /></div>
      </div>
      <div class="feature-row reverse">
        <div class="feature-copy"><h3>{t.agentTitle}</h3><p>{t.agentBody}</p><a class="text-link" href={doc('study-planner')}>{t.agentLink}<span aria-hidden="true">↗</span></a></div>
        <div class="feature-image"><Window name="planner" alt={t.plannerAlt} /></div>
      </div>
      <div class="feature-row">
        <div class="feature-copy"><h3>{t.readerTitle}</h3><p>{t.readerBody}</p><a class="text-link" href={doc('reading-documents')}>{t.readerLink}<span aria-hidden="true">↗</span></a><p class="feature-note">{t.readerNote}</p></div>
        <div class="feature-image reading-image"><Window name="reader" alt={t.readerAlt} /></div>
      </div>
      <div class="extra-features">
        {t.extras.map(([title,body,slug],index) => <div class="extra-feature">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">{index === 0 ? <><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6M7 10h6m-6-3h4"/></> : <><rect x="2" y="4" width="20" height="16" rx="3"/><path d="M2 9h20m-15-3h1m2 0h1"/></>}</svg>
          <h3>{title}</h3><p>{body}</p><a class="text-link" href={doc(slug)}>{t.docs}<span aria-hidden="true">↗</span><span class="sr-only">{title}</span></a>
        </div>)}
      </div>
    </section>

    <section class="privacy-section">
      <div class="container privacy-inner">
        <div><h2>{t.privacyTitle}</h2><p>{t.privacyBody}</p><a class="text-link" href={doc('privacy-and-network')}>{t.privacyLink}<span aria-hidden="true">↗</span></a></div>
        <div class="privacy-diagram"><svg width="100" height="84" viewBox="0 0 100 84" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="15" y="6" width="70" height="49" rx="6"/><path d="M5 63h90l-6 9H11zM43 26l6 6 11-12"/></svg><p>{t.privacyDetail}</p></div>
      </div>
    </section>

    <section class="themes-section container" aria-labelledby="themes-title">
      <div class="themes-heading"><h2 id="themes-title">{t.themesTitle}</h2><p>{t.themesBody}</p></div>
      <div class="theme-picker" aria-label={t.themesTitle}>
        {previews.map((pack,index) => <button class="theme-choice" data-theme-id={pack.id} data-light-shot={pack.lightShot} data-dark-shot={pack.darkShot} aria-pressed={index === 0}>
          <span class="orbs" aria-hidden="true"><span style={`--orb-bg:${pack.light[0]};--orb-accent:${pack.light[7]}`}></span><span style={`--orb-bg:${pack.dark[0]};--orb-accent:${pack.dark[7]}`}></span></span>
          {t.themeNames[index]}
        </button>)}
      </div>
      <p class="theme-hint">{t.themeHint}</p>
      <div class="theme-pair"><figure id="theme-light"><Window name="courses-home-vstudy-light" alt={`${t.themeNames[0]} · ${t.lightPreview}`} size={720} /><figcaption>{t.lightPreview}</figcaption></figure><figure id="theme-dark"><Window name="courses-home-vstudy-dark" alt={`${t.themeNames[0]} · ${t.darkPreview}`} size={720} /><figcaption>{t.darkPreview}</figcaption></figure></div>
    </section>

    <section class="faq-section container" aria-labelledby="faq-title">
      <h2 id="faq-title">{t.faqTitle}</h2>
      <div class="faqs">{t.faqs.map(([question,answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div>
    </section>
    <section class="final-section container">
      <h2>{t.finalTitle}</h2><p>{t.finalBody}</p>
      <Download {language} />
      <a class="text-link" href={doc('getting-started')}>{t.firstLaunch}<span aria-hidden="true">↗</span></a>
    </section>
  </main>
</Base>
<script>
  import palettes from '../../../desktop/src/shared/themes/palettes.json';
  let selected: typeof palettes[number] | undefined = palettes[0];
  function applyPack() {
    if (!selected) return;
    const dark = document.documentElement.dataset.scheme === 'dark';
    const colors = dark ? selected.dark : selected.light;
    const keys = ['background','surface','subtle','active','ink','muted','line','accent'];
    keys.forEach((key,index) => document.documentElement.style.setProperty(`--${key}`, colors[index] ?? ''));
    document.documentElement.style.setProperty('--focus', colors[7] ?? '');
    document.documentElement.style.setProperty('--on-accent', dark ? colors[0] ?? '' : '#ffffff');
  }
  document.querySelectorAll<HTMLButtonElement>('[data-theme-id]').forEach(button => button.addEventListener('click', () => {
    selected = palettes.find(pack => pack.id === button.dataset.themeId);
    document.querySelectorAll('[data-theme-id]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    const light = document.querySelector<HTMLImageElement>('#theme-light img');
    const dark = document.querySelector<HTMLImageElement>('#theme-dark img');
    if (light && button.dataset.lightShot) { light.src = button.dataset.lightShot; light.alt = `${button.textContent?.trim()} · ${light.closest('figure')?.querySelector('figcaption')?.textContent}`; }
    if (dark && button.dataset.darkShot) { dark.src = button.dataset.darkShot; dark.alt = `${button.textContent?.trim()} · ${dark.closest('figure')?.querySelector('figcaption')?.textContent}`; }
    applyPack();
  }));
  document.addEventListener('scheme-change', applyPack);
</script>
