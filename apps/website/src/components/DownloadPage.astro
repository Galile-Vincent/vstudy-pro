---
import Base from '../layouts/Base.astro';
import Logo from './Logo.astro';
import { path, RELEASES_URL } from '../config';
import { downloadBase, installers, type InstallerId } from '../data/downloads';
import { installCopy, macInstall, windowsInstall, reviewedInstall } from '../data/install-copy';
import { downloadCopy } from '../data/download-copy';
import type { Language } from '../data/ui';
import '../styles/download.css';
interface Props { language: Language; }
const { language } = Astro.props;
const c = downloadCopy[language];
const install = installCopy[language];
const promptLabel = { en: 'Prompt for your AI agent', 'zh-Hant': '給 AI 智能體的提示詞', ja: 'AI エージェント用のプロンプト' }[language];
const groups = [
  { platform: 'mac', name: c.osMac, hint: c.macHint },
  { platform: 'win', name: c.osWin, hint: c.winHint },
] as const;
const kindLabel = { dmg: c.dmg, exe: c.exe };
const href = (file: string) => `${downloadBase}/${file}`;
---
<Base {language} title={c.title} description={c.metaDescription} page="download/">
  <main id="main" tabindex="-1" class="dl container">
    <header class="dl-head">
      <span class="dl-mark"><Logo /></span>
      <h1>{c.title}</h1>
      <p class="dl-lead">{c.lead}</p>
    </header>

    <section class="dl-info" aria-labelledby="dl-script">
      <h2 id="dl-script">{install.title}</h2>
      <p>{install.text.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')} <a href="https://raw.githubusercontent.com/ava-apple/vstudy-pro/main/scripts/install/install.sh">install.sh</a></p>
      {[{ label: 'macOS', code: macInstall }, { label: install.read, code: reviewedInstall }, { label: install.windows, code: windowsInstall }, { label: promptLabel, code: install.prompt }].map(({ label, code }) => (
        <div class="code-block">
          <p>{label}</p>
          <button type="button" data-install-copy>{install.copy}</button>
          <pre tabindex="0"><code>{code}</code></pre>
        </div>
      ))}
      <p>{install.options.replace(/`/g, '')}</p>
      <p>{install.update.replace(/[`*]/g, '')}</p>
      <p class="sr-only" role="status" data-install-status></p>
    </section>

    <section class="dl-recommend" data-recommend hidden aria-labelledby="dl-rec-title">
      <p class="dl-eyebrow">{c.recommended}</p>
      <div class="dl-rec-body">
        <div class="dl-rec-copy">
          <h2 id="dl-rec-title" data-rec-title></h2>
          <p data-rec-meta></p>
        </div>
        <a class="button" data-rec-link hidden>{c.getIt}<span aria-hidden="true">↓</span></a>
      </div>
      <p class="dl-rec-planned" data-rec-planned hidden>{c.unavailable}</p>
    </section>
    <p class="dl-unknown" data-unknown hidden>{c.unknown}</p>

    {groups.map(group => (
      <section class="dl-os" aria-labelledby={`dl-${group.platform}`}>
        <h2 id={`dl-${group.platform}`}>
          {group.platform === 'mac'
            ? <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="5" width="16" height="11" rx="1.5"/><path d="M2.5 19h19"/></svg>
            : <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="4" width="17" height="16" rx="2"/><path d="M12 4v16M3.5 12h17"/></svg>}
          {group.name}
        </h2>
        <ul class="dl-cards">
          {installers.filter(installer => installer.platform === group.platform).map(installer => {
            const copy = c.arch[installer.id as InstallerId];
            const body = <>
              <span class="dl-type" aria-hidden="true">.{installer.kind}</span>
              <span class="dl-card-text">
                <span class="dl-card-name">{copy.name}<span class="dl-badge" data-badge hidden>{c.badge}</span></span>
                <span class="dl-card-note">{copy.note}</span>
                <span class="dl-card-kind">{kindLabel[installer.kind]}</span>
              </span>
            </>;
            return <li class:list={['dl-card', { 'is-planned': !installer.releaseEnabled }]}>
              {installer.releaseEnabled
                ? <a class="dl-card-main" href={href(installer.file)} data-installer={installer.id} data-title={installer.label} data-meta={`${kindLabel[installer.kind]} · ${copy.note}`} data-href={href(installer.file)}>
                    {body}
                    <svg class="dl-go" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12m0 0-5-5m5 5 5-5M5 20h14"/></svg>
                  </a>
                : <div class="dl-card-main" data-installer={installer.id} data-title={installer.label} data-meta={`${kindLabel[installer.kind]} · ${copy.note}`} aria-disabled="true">
                    {body}
                    <span class="dl-pill">{c.planned}</span>
                  </div>}
            </li>;
          })}
        </ul>
        <p class="dl-hint">{group.hint}</p>
      </section>
    ))}

    <section class="dl-os" aria-labelledby="dl-linux">
      <h2 id="dl-linux">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="14" rx="2"/><path d="m8 10 3 2.5L8 15M13 15h3.5"/></svg>
        {c.osLinux}
      </h2>
      <p class="dl-none">{c.noLinux}</p>
    </section>

    <section class="dl-info" aria-labelledby="dl-req">
      <h2 id="dl-req">{c.requirementsTitle}</h2>
      <p>{c.requirements}</p>
      <ul class="dl-links">
        <li><a class="text-link" href={`${downloadBase}/SHA256SUMS.txt`}>{c.checksums}<span aria-hidden="true">↓</span></a></li>
        <li><a class="text-link" href={RELEASES_URL}>{c.releases}<span aria-hidden="true">↗</span></a></li>
      </ul>
    </section>

    <details class="dl-help">
      <summary>{c.safety}<span aria-hidden="true">+</span></summary>
      <div class="dl-help-body">
        <p>{c.unsigned}</p><p>{c.mac}</p><p>{c.win}</p><p>{c.signed}</p>
        <a class="text-link" href={path(`${language}/docs/getting-started/`)}>{c.help}<span aria-hidden="true">→</span></a>
      </div>
    </details>
    <p class="dl-status">{c.status}</p>
  </main>
</Base>
<script>
  import { installCopy } from '../data/install-copy';
  document.querySelectorAll<HTMLButtonElement>('[data-install-copy]').forEach(button => {
    button.addEventListener('click', async () => {
      const language = document.documentElement.lang as keyof typeof installCopy;
      const labels = installCopy[language] ?? installCopy.en;
      try {
        await navigator.clipboard.writeText(button.parentElement?.querySelector('code')?.textContent ?? '');
        button.textContent = labels.copied;
      } catch {
        button.textContent = labels.failed;
      }
      const status = document.querySelector('[data-install-status]');
      if (status) status.textContent = button.textContent;
    });
  });
  import { detectInstaller } from '../scripts/platform';
  const panel = document.querySelector<HTMLElement>('[data-recommend]');
  const unknown = document.querySelector<HTMLElement>('[data-unknown]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-installer]')];
  detectInstaller(id => {
    cards.forEach(card => {
      card.closest('.dl-card')?.classList.remove('is-recommended');
      card.querySelector<HTMLElement>('[data-badge]')!.hidden = true;
    });
    const card = cards.find(item => item.dataset.installer === id);
    if (!panel || !unknown) return;
    panel.hidden = !card;
    unknown.hidden = !!card;
    if (!card) return;
    card.closest('.dl-card')?.classList.add('is-recommended');
    card.querySelector<HTMLElement>('[data-badge]')!.hidden = false;
    panel.querySelector('[data-rec-title]')!.textContent = card.dataset.title ?? '';
    panel.querySelector('[data-rec-meta]')!.textContent = card.dataset.meta ?? '';
    const link = panel.querySelector<HTMLAnchorElement>('[data-rec-link]')!;
    const planned = panel.querySelector<HTMLElement>('[data-rec-planned]')!;
    if (card.dataset.href) link.href = card.dataset.href; else link.removeAttribute('href');
    link.hidden = !card.dataset.href;
    planned.hidden = !!card.dataset.href;
  });
</script>
