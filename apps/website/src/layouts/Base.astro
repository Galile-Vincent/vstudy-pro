---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Download from '../components/Download.astro';
import { path, REPO_URL, VERSION } from '../config';
import { languages, languageNames, ui, type Language } from '../data/ui';
interface Props { language: Language; title: string; description: string; slug?: string; docs?: boolean; }
const { language, title, description, slug = '', docs = false } = Astro.props;
const t = ui[language];
const route = (lang: Language) => path(`${lang}/${docs ? `docs/${slug}/` : ''}`);
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · VStudy Pro</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {languages.map(lang => <link rel="alternate" hreflang={lang} href={new URL(route(lang), Astro.site)} />)}
    <meta property="og:title" content={`${title} · VStudy Pro`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(path('og.png'), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={path('favicon.svg')} />
    <script is:inline>
      try {
        const saved = localStorage.getItem('vstudy-scheme');
        document.documentElement.dataset.scheme = saved === 'light' || saved === 'dark' ? saved : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      } catch { document.documentElement.dataset.scheme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="site-header">
      <nav class="nav container" aria-label="VStudy Pro">
        <a class="brand" href={path(`${language}/`)}><Logo />VStudy Pro</a>
        <div class="nav-links">
          <a class="desktop-link" href={path(`${language}/#features`)}>{t.features}</a>
          <a href={path(`${language}/docs/getting-started/`)} aria-current={docs ? 'page' : undefined}>{t.docs}</a>
          <a class="desktop-link" href={REPO_URL}>GitHub</a>
          <Download {language} compact />
        </div>
        <div class="nav-tools">
          <label class="sr-only" for="site-language">{t.language}</label>
          <select id="site-language" class="language-select">
            {languages.map(lang => <option value={route(lang)} selected={lang === language}>{languageNames[lang]}</option>)}
          </select>
          <button class="scheme-button" id="scheme-toggle" aria-label={t.appearance}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
          </button>
        </div>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="container footer-inner">
        <div><a class="brand" href={path(`${language}/`)}><Logo />VStudy Pro</a><p>{t.footer}</p><p><small>{t.version} {VERSION}</small></p></div>
        <div class="footer-links"><a href={path(`${language}/docs/getting-started/`)}>{t.docs}</a><a href={path(`${language}/docs/privacy-and-network/`)}>{t.privacy}</a><a href={REPO_URL}>{t.source}</a></div>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('#scheme-toggle');
      const system = matchMedia('(prefers-color-scheme: dark)');
      let manual = false;
      try { manual = ['light','dark'].includes(localStorage.getItem('vstudy-scheme') ?? ''); } catch {}
      toggle?.addEventListener('click', () => {
        const scheme = document.documentElement.dataset.scheme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.scheme = scheme;
        manual = true;
        try { localStorage.setItem('vstudy-scheme', scheme); } catch {}
        document.dispatchEvent(new Event('scheme-change'));
      });
      system.addEventListener('change', event => {
        if (manual) return;
        document.documentElement.dataset.scheme = event.matches ? 'dark' : 'light';
        document.dispatchEvent(new Event('scheme-change'));
      });
      document.querySelector<HTMLSelectElement>('#site-language')?.addEventListener('change', event => {
        if (event.currentTarget instanceof HTMLSelectElement) location.href = event.currentTarget.value;
      });
    </script>
  </body>
</html>
