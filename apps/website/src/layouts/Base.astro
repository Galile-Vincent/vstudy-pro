---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import OsDownloadButton from '../components/OsDownloadButton.astro';
import { CONTACT_EMAIL, FOUNDER_URL, LINKEDIN_URL, path, REPO_URL, THREADS_URL, VERSION } from '../config';
import { languages, languageNames, ui, type Language } from '../data/ui';
interface Props { language: Language; title: string; description: string; slug?: string; docs?: boolean; page?: string; }
const { language, title, description, slug = '', docs = false, page = '' } = Astro.props;
const t = ui[language];
const route = (lang: Language) => path(`${lang}/${docs ? `docs/${slug}/` : page}`);
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · VStudy Pro</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {languages.map(lang => <link rel="alternate" hreflang={lang} href={new URL(route(lang), Astro.site)} />)}
    <meta property="og:title" content={`${title} · VStudy Pro`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(path('og.png'), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={path('favicon.svg')} />
    <link rel="icon" href={path('favicon.ico')} sizes="any" />
    <link rel="apple-touch-icon" href={path('apple-touch-icon.png')} />
    <link rel="manifest" href={path('manifest.webmanifest')} />
    <script is:inline>
      try {
        const saved = localStorage.getItem('vstudy-scheme');
        document.documentElement.dataset.scheme = saved === 'light' || saved === 'dark' ? saved : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      } catch { document.documentElement.dataset.scheme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="site-header">
      <nav class="nav container" aria-label="VStudy Pro">
        <a class="brand" aria-label="VStudy Pro" href={path(`${language}/`)}><Logo lockup /></a>
        <div class="nav-links">
          <a href={path(`${language}/#features`)}>{t.features}</a>
          <a href={path(`${language}/docs/getting-started/`)} aria-current={docs ? 'page' : undefined}>{t.docs}</a>
        </div>
        <div class="nav-end">
          <OsDownloadButton {language} compact current={page === 'download/'} />
          <details class="menu" data-menu>
            <summary class="menu-button" aria-label={t.settings}>
              <svg class="icon-gear" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
              <svg class="icon-menu" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </summary>
            <div class="menu-panel">
              <nav class="menu-group menu-pages" aria-label={t.menu}>
                <a href={path(`${language}/#features`)}>{t.features}</a>
                <a href={path(`${language}/docs/getting-started/`)} aria-current={docs ? 'page' : undefined}>{t.docs}</a>
              </nav>
              <div class="menu-group" role="group" aria-labelledby="menu-language">
                <p class="menu-label" id="menu-language">{t.language}</p>
                {languages.map(lang => <a class="menu-item" href={route(lang)} lang={lang} hreflang={lang} aria-current={lang === language ? 'true' : undefined}>{languageNames[lang]}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10"/></svg></a>)}
              </div>
              <div class="menu-group" role="group" aria-labelledby="menu-theme">
                <p class="menu-label" id="menu-theme">{t.theme}</p>
                <div class="segmented">
                  <button type="button" data-scheme-set="light" aria-pressed="false">{t.light}</button>
                  <button type="button" data-scheme-set="dark" aria-pressed="false">{t.dark}</button>
                </div>
              </div>
            </div>
          </details>
        </div>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="container footer-inner">
        <div><a class="brand" aria-label="VStudy Pro" href={path(`${language}/`)}><Logo lockup /></a><p>{t.footer}</p>{VERSION && <p><small>{t.version} {VERSION}</small></p>}</div>
        <div class="footer-links"><a href={path(`${language}/download/`)}>{t.download}</a><a href={path(`${language}/docs/getting-started/`)}>{t.docs}</a><a href={path(`${language}/privacy/`)}>{t.privacy}</a><a href={path(`${language}/terms/`)}>{t.terms}</a><a href={REPO_URL}>{t.source}</a></div>
        <nav class="footer-contact" aria-label={t.contact}>
          <strong>{t.contact}</strong>
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
          <a href={FOUNDER_URL} rel="noopener">{t.aboutStudio}</a>
          <a href={LINKEDIN_URL} rel="me noopener">LinkedIn</a>
          <a href={THREADS_URL} rel="me noopener">Threads</a>
        </nav>
      </div>
      <div class="container footer-credit"><small>{t.builtBy}</small></div>
    </footer>
    <script>
      import { transitionTheme } from '../scripts/theme';
      requestAnimationFrame(() => { document.documentElement.dataset.themeReady = ''; });
      const schemeButtons = document.querySelectorAll<HTMLButtonElement>('[data-scheme-set]');
      const system = matchMedia('(prefers-color-scheme: dark)');
      let manual = false;
      try { manual = ['light','dark'].includes(localStorage.getItem('vstudy-scheme') ?? ''); } catch {}
      const syncSchemeButtons = () => schemeButtons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.schemeSet === document.documentElement.dataset.scheme)));
      syncSchemeButtons();
      schemeButtons.forEach(button => button.addEventListener('click', () => {
        const scheme = button.dataset.schemeSet === 'dark' ? 'dark' : 'light';
        manual = true;
        try { localStorage.setItem('vstudy-scheme', scheme); } catch {}
        if (document.documentElement.dataset.scheme === scheme) return;
        transitionTheme(() => {
          document.documentElement.dataset.scheme = scheme;
          document.dispatchEvent(new Event('scheme-change'));
          syncSchemeButtons();
        });
      }));
      system.addEventListener('change', event => {
        if (manual) return;
        transitionTheme(() => {
          document.documentElement.dataset.scheme = event.matches ? 'dark' : 'light';
          document.dispatchEvent(new Event('scheme-change'));
          syncSchemeButtons();
        });
      });
      const menu = document.querySelector<HTMLDetailsElement>('[data-menu]');
      document.addEventListener('keydown', event => {
        if (event.key !== 'Escape' || !menu?.open) return;
        menu.open = false;
        menu.querySelector('summary')?.focus();
      });
      document.addEventListener('click', event => { if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false; });
      menu?.addEventListener('focusout', event => { if (menu.open && event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) menu.open = false; });
      const header = document.querySelector('.site-header');
      const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 12);
      updateHeader();
      window.addEventListener('scroll', updateHeader, { passive: true });
    </script>
  </body>
</html>
