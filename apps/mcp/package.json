{
  "name": "@vstudy/mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Credential-free stdio bridge to VStudy Pro",
  "type": "module",
  "bin": {
    "vstudy-mcp": "dist/vstudy-mcp.cjs"
  },
  "exports": {
    "./installer": "./dist/installer.cjs"
  },
  "files": [
    "dist",
    "plugins"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "pnpm build && vitest run --pool=forks --maxWorkers=2",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "node scripts/verify-artifact.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=24.11.1"
  }
}
