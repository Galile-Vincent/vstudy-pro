{
  "name": "@vstudy/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Document reading and grounded AI chat",
  "author": "vstudy",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "package": "pnpm build && electron-builder --mac dmg dir",
    "smoke": "pnpm build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@assistant-ui/generative-ui": "0.0.8",
    "@assistant-ui/react": "0.15.32",
    "@assistant-ui/react-markdown": "0.14.24",
    "@base-ui/react": "1.9.0",
    "beautiful-mermaid": "1.1.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "decode-named-character-reference": "1.3.0",
    "katex": "0.16.47",
    "leaflet": "1.9.4",
    "lucide-react": "1.67.0",
    "radix-ui": "1.8.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "2.1.9",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "tw-shimmer": "0.4.14",
    "unified": "11.0.5",
    "zod": "3.24.2",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@tailwindcss/vite": "4.1.18",
    "@types/hast": "3.0.5",
    "@types/leaflet": "1.9.21",
    "@types/mdast": "4.0.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "40.0.0",
    "electron-builder": "26.0.12",
    "electron-vite": "5.0.0",
    "eslint": "9.39.1",
    "jsdom": "30.1.3",
    "playwright": "1.56.1",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "7.2.2",
    "vitest": "3.2.4"
  },
  "build": {
    "appId": "com.vstudy.pro",
    "productName": "VStudy Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/converter",
        "to": "converter"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "dir"
      ],
      "category": "public.app-category.education"
    }
  }
}
