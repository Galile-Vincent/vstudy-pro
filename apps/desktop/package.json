{
  "name": "@vstudy/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Document reading and grounded AI chat",
  "author": "vstudy",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "package": "pnpm build && electron-builder --mac dmg dir",
    "smoke": "pnpm build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-resizable-panels": "2.1.9",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "40.0.0",
    "electron-builder": "26.0.12",
    "electron-vite": "5.0.0",
    "eslint": "9.39.1",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "7.2.2",
    "vitest": "3.2.4",
    "playwright": "1.56.1"
  },
  "build": {
    "appId": "com.vstudy.pro",
    "productName": "VStudy Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/converter",
        "to": "converter"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "dir"
      ],
      "category": "public.app-category.education"
    }
  }
}
