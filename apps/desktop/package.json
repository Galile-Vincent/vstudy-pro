{
  "name": "@vstudy/desktop",
  "version": "0.2.2",
  "private": true,
  "description": "Document reading and grounded AI chat",
  "author": "vstudy",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/generate-locales.mjs && electron-vite dev",
    "build": "pnpm --filter @vstudy/mcp build && node scripts/build-mcp-platform.mjs && node scripts/generate-locales.mjs && electron-vite build",
    "test": "node scripts/generate-locales.mjs && node scripts/check-contrast.mjs && vitest run",
    "contrast:check": "node scripts/check-contrast.mjs",
    "typecheck": "node scripts/generate-locales.mjs && tsc --noEmit",
    "lint": "eslint .",
    "package": "pnpm build && node scripts/package-platform.mjs",
    "smoke": "pnpm build && node scripts/smoke.mjs",
    "package:verify": "npx --no-install @electron/fuses read --app \"release/mac-arm64/VStudy Pro.app\" && python3 scripts/verify-packaged.py",
    "locales:generate": "node scripts/generate-locales.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.32",
    "@assistant-ui/react-markdown": "0.14.24",
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "decode-named-character-reference": "1.3.0",
    "highlight.js": "11.11.2",
    "i18next": "25.6.3",
    "katex": "0.16.47",
    "lowlight": "3.3.0",
    "lucide-react": "1.67.0",
    "radix-ui": "1.8.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "16.3.5",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "2.1.9",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "tailwind-merge": "3.6.0",
    "tldts": "7.4.19",
    "tw-animate-css": "1.4.0",
    "tw-shimmer": "0.4.14",
    "unified": "11.0.5",
    "zod": "3.24.2",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@cyclonedx/cyclonedx-npm": "6.0.0",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "9.39.1",
    "@tailwindcss/vite": "4.1.18",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "42.11.16",
    "electron-builder": "26.15.0",
    "electron-vite": "5.0.0",
    "eslint": "9.39.1",
    "eslint-plugin-electron-security": "0.3.0",
    "jsdom": "30.1.3",
    "playwright": "1.56.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "build": {
    "appId": "com.vstudy.pro",
    "productName": "VStudy Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!out/**/*.map",
      "package.json",
      "!**/{test,tests,__tests__,fixtures,docs,e2e}/**",
      "!**/*.test.*",
      "!**/*.map",
      "!**/*.md",
      "!**/*.test.*",
      "!**/test/**",
      "!**/__fixtures__/**",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "resources/converter",
        "to": "converter",
        "filter": [
          "**/*.py",
          "requirements*.txt",
          "!**/test_*",
          "!**/__pycache__/**",
          "!**/profile*"
        ]
      },
      {
        "from": "resources/samples",
        "to": "samples"
      },
      {
        "from": "../mcp/dist",
        "to": "mcp/dist"
      },
      {
        "from": "../mcp/plugins",
        "to": "mcp/plugins"
      },
      {
        "from": "../mcp/CLIENT_FORMATS.md",
        "to": "mcp/CLIENT_FORMATS.md"
      },
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "mcp-peer"
        ]
      }
    ],
    "mac": {
      "artifactName": "VStudy-Pro-${version}-${arch}.${ext}",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "dir"
      ],
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "asar": true,
    "afterPack": "scripts/after-pack.mjs",
    "protocols": [
      {
        "name": "VStudy Moodle sign-in",
        "schemes": [
          "vstudymoodle"
        ]
      }
    ]
  }
}
