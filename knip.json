{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.{mjs,cjs,ts}"
      ],
      "project": [
        "scripts/**/*.{mjs,cjs,ts}"
      ]
    },
    "apps/desktop": {
      "entry": [
        "src/main/index.ts",
        "src/main/services/search-worker.ts",
        "resources/converter/**/*.ts",
        "scripts/**/*.{mjs,cjs,ts}",
        "e2e/**/*.mjs",
        "src/**/*.test.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "resources/**/*.ts",
        "scripts/**/*.{mjs,cjs,ts}",
        "e2e/**/*.mjs"
      ],
      "ignoreDependencies": [
        "@cyclonedx/cyclonedx-npm",
        "tailwindcss",
        "tw-animate-css",
        "tw-shimmer"
      ],
      "ignoreBinaries": [
        "openssl"
      ],
      "ignore": [
        "src/renderer/components/assistant-ui/elements/tool-approval-questions.tsx",
        "src/renderer/components/assistant-ui/elements/tool-fallback-parts.tsx",
        "src/renderer/components/ui/alert-dialog.tsx",
        "src/renderer/components/ui/context-menu.tsx",
        "src/renderer/components/ui/scroll-area.tsx"
      ]
    }
  }
}
