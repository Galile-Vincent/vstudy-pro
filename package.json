{
  "name": "vstudy-pro",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "dev": "pnpm --filter @vstudy/desktop dev",
    "build": "pnpm --filter @vstudy/desktop build",
    "test": "pnpm --filter @vstudy/desktop test",
    "typecheck": "pnpm --filter @vstudy/desktop typecheck",
    "package": "pnpm --filter @vstudy/desktop package",
    "lint": "pnpm --filter @vstudy/desktop lint",
    "smoke": "pnpm --filter @vstudy/desktop smoke",
    "security:check": "node apps/desktop/scripts/security-audit.mjs && pnpm lint && pnpm --filter @vstudy/desktop exec node scripts/security-lint.mjs && pnpm test",
    "e2e": "node apps/desktop/scripts/e2e.mjs",
    "knip": "knip --include files,dependencies,unlisted,binaries",
    "package:signed": "node apps/desktop/scripts/package-signed.mjs",
    "vendor:check": "node apps/desktop/scripts/vendor-check.mjs"
  },
  "devDependencies": {
    "knip": "6.44.1"
  }
}
